{
  "name": "pi-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch src/backend/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "prestart": "npm run build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/backend/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "verify:container": "bash scripts/container-smoke.sh"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "chokidar": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "typebox": "^1.3.35",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.5",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.16",
    "jsdom": "^30.1.2",
    "marked": "^18.0.14",
    "supertest": "^7.3.1",
    "svelte": "^5.57.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
