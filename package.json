{
  "name": "pi-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch src/backend/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "prestart": "npm run build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/backend/index.js",
    "test": "vitest run && npm run test:guardrails",
    "test:guardrails": "node --test scripts/test/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "node scripts/lint-fix.mjs",
    "format": "node scripts/format.mjs",
    "format:all": "node scripts/format.mjs --all",
    "format:fix": "node scripts/format.mjs --write",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "check:deps": "node scripts/check-deps.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:all && npm run check:deps && npm run test:guardrails",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "verify:container": "bash scripts/container-smoke.sh"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "chokidar": "6.0.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "typebox": "1.4.5",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "codemirror": "6.0.2",
    "concurrently": "10.0.6",
    "diff2html": "3.4.56",
    "dompurify": "3.4.17",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "marked": "18.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "supertest": "7.3.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "undici": "8.12.3"
  }
}
